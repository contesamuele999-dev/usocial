# Caddy: reverse proxy con HTTPS automatico (Let's Encrypt).
# Il dominio arriva dalla variabile APP_DOMAIN (impostata in .env e passata
# al container caddy nel docker-compose.prod.yml).
# Caddy ottiene e rinnova da solo il certificato TLS: nessuna configurazione manuale.
{$APP_DOMAIN} {
	# --- Media: serviti da Caddy, non da Node ---------------------------------
	# /files/:nome corrisponde a un file reale in data/media (montato in sola
	# lettura su /srv/files). Farli passare da Node significava tenere l'intero
	# video in RAM: su una VM da 1 GB bastava aprire la Libreria per mandarla in
	# swap e far sembrare l'app bloccata. Caddy li invia con sendfile, supporta
	# le richieste Range e non tocca il processo dell'app.
	handle /files/* {
		# `route` serve a garantire QUESTO ordine: senza, Caddy riordina le
		# direttive secondo il suo elenco standard, dove `reverse_proxy` viene
		# prima di `file_server` — cioè ogni media finiva a Node e il
		# file_server non entrava mai in funzione.
		route {
			# La cartella è montata su /srv/files, non /srv/media, così l'URL
			# /files/:nome corrisponde già al percorso su disco e non serve
			# togliere il prefisso. Il vecchio `uri strip_prefix /files`
			# riscriveva l'URI anche per la richiesta inoltrata a Node, che
			# quindi riceveva "/:nome" e rispondeva 404: i poster dei video non
			# venivano mai generati e le anteprime restavano vuote.
			root * /srv
			# `pass_thru`: se il file non esiste ancora (tipicamente il poster di
			# un video, generato su richiesta) la richiesta prosegue verso l'app.
			file_server {
				pass_thru
			}
			reverse_proxy 172.28.0.10:3000 {
				lb_try_duration 10s
				lb_try_interval 500ms
			}
		}
	}

	handle {
		# IP fisso invece del nome `usocial`: il DNS interno di Docker, sotto
		# pressione di memoria, andava in timeout e il sito rispondeva 502 pur
		# essendo l'app viva (vedi docker-compose.prod.yml).
		reverse_proxy 172.28.0.10:3000 {
			# Durante un riavvio del container la connessione viene rifiutata per
			# qualche secondo: riprova invece di restituire subito 502.
			lb_try_duration 10s
			lb_try_interval 500ms
		}
	}
}
