# ============================================================
# uSocial — Social Publisher AI
# Copia questo file in `.env` e compila i valori che ti servono.
# L'app funziona anche SENZA credenziali social: potrai registrarti,
# creare bozze, programmare post e usare l'AI (provider "mock" di default).
# Le credenziali social qui sotto sono a livello di APP (le registri UNA
# volta tu, l'amministratore): poi OGNI utente collega il proprio account
# social dalla web app, in Impostazioni → Connetti.
#
# ⚠️  NON inserire qui chiavi reali: questo file viene committato su git.
#     I valori qui sotto sono solo segnaposto di esempio.
# ============================================================

# URL pubblico dell'app (usato per i redirect OAuth e per servire i media
# a Instagram/Facebook, che richiedono URL raggiungibili da internet).
APP_URL=http://localhost:3000

# Solo per il deploy di produzione (docker-compose.prod.yml + Caddy):
# il dominio pubblico che punta al server. Deve combaciare con APP_URL.
# Esempio: APP_DOMAIN=iltuonome.duckdns.org e APP_URL=https://usocial.duckdns.org
APP_DOMAIN=usocial.duckdns.org

# Cartella dati (database SQLite + media caricati)
DATA_DIR=./data

# Quota di spazio PER UTENTE, in megabyte (default: 2048 = 2 GB).
# La VM ha un disco condiviso (~30 GB): 2 GB a utente permette una quindicina di
# account lasciando margine a sistema, database e file temporanei di ffmpeg.
# La barra "Memoria" nella sidebar mostra il consumo; oltre la quota gli upload
# vengono rifiutati con un messaggio esplicito.
USER_QUOTA_MB=2048

# Percorso di ffmpeg/ffprobe. Lascia vuoto per usare il binario di ffmpeg-static
# o quello di sistema (rilevato automaticamente).
# IMPORTANTE su VM Linux: se hai eseguito `npm install` su Windows, ffmpeg-static
# contiene solo ffmpeg.exe e NON funziona. Installa ffmpeg di sistema con
#   sudo apt-get install -y ffmpeg
# oppure indica qui il percorso corretto.
FFMPEG_PATH=
FFPROBE_PATH=

# Registrazione nuovi utenti: true (default) | false.
# Se la metti a false dopo aver creato i tuoi account, l'app resta privata
# (il PRIMO utente in assoluto può registrarsi comunque, per il setup iniziale).
ALLOW_REGISTRATION=true

# ---------- AI ----------
# Provider: mock | gemini | anthropic | openai | ollama
# Suggerito: gemini con modello gemini-2.5-flash (GRATIS con Google AI Studio).
# Chiave gratuita: https://aistudio.google.com/apikey
# (la config AI è anche modificabile a runtime da Impostazioni, per ogni utente)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_API_KEY=your-ai-api-key-here
# Solo per ollama (default http://localhost:11434)
AI_BASE_URL=

# ---------- Facebook / Instagram (Meta Graph API) ----------
# App su https://developers.facebook.com — prodotto "Facebook Login for Business"
META_CLIENT_ID=your-meta-client-id
META_CLIENT_SECRET=your-meta-client-secret

# ---------- Threads (Meta) ----------
# Stessa app Meta di Facebook/Instagram MA credenziali diverse: aggiungi il caso
# d'uso "Threads API" all'app e copia "Threads App ID" e "Threads App Secret".
# Redirect da autorizzare nell'app: {APP_URL}/api/connect/threads/callback
THREADS_CLIENT_ID=your-threads-app-id
THREADS_CLIENT_SECRET=your-threads-app-secret

# ---------- LinkedIn ----------
# App su https://developer.linkedin.com — prodotto "Share on LinkedIn" + "Sign In with LinkedIn"
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# ---------- YouTube (Google Cloud) ----------
# Progetto su https://console.cloud.google.com — YouTube Data API v3, OAuth consent screen
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---------- TikTok ----------
# App su https://developers.tiktok.com — Content Posting API
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# Statistiche TikTok: richiede il permesso `video.list`, che va prima
# abilitato nell'app su developers.tiktok.com. Mettendolo a true l'app lo
# chiede al consenso: gli account gia' collegati vanno ricollegati.
TIKTOK_SCOPE_VIDEO_LIST=false

# ---------- Montaggio video (opzionale) ----------
# Percorso a un binario ffmpeg di sistema. Se vuoto, si usa quello incluso
# dal pacchetto npm "ffmpeg-static". Utile in Docker: es. /usr/bin/ffmpeg
FFMPEG_PATH=

# ---------- Repurposing (opzionale) ----------
# Whisper LOCALE per sottotitoli/descrizioni da parlato (CLI openai-whisper)
WHISPER_PATH=whisper          # es. whisper  (lascia vuoto per disattivare)
WHISPER_MODEL=base     # tiny | base | small | medium
WHISPER_LANG=          # es. it  (vuoto = autodetect)
# B-roll automatici da stock
PEXELS_API_KEY=your-pexels-api-key
